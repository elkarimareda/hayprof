# Frontend Environment for hayprof.com
# Copy this to frontend/.env

VITE_API_URL=https://hayprof.com/api
VITE_APP_URL=https://hayprof.com
VITE_APP_NAME=HayProf

# Optional: Analytics
VITE_GOOGLE_ANALYTICS_ID=

# Optional: Social Login
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=

# Optional: Payment
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: Maps
VITE_GOOGLE_MAPS_API_KEY=
